tact","ph":"संपर्क"},{"t":"X (Twitter)","u":"contact.html#social","g":"Sections","p":"Contact","ph":"संपर्क"},{"t":"Amer Fort & Palace","h":"आमेर किला और महल","u":"map.html#place-amer","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Hilltop palace-fort of the Kachhwaha Rajputs – Sheesh Mahal, Ganesh Pol and sweeping Aravalli views."},{"t":"Hawa Mahal","h":"हवा महल","u":"map.html#place-hawa","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"The iconic Palace of Winds with 953 jharokhas, built in 1799."},{"t":"City Palace","h":"सिटी पैलेस","u":"map.html#place-citypalace","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Royal residence and museum with the famous Peacock Gate."},{"t":"Jantar Mantar","h":"जंतर मंतर","u":"map.html#place-jantar","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"UNESCO-listed 18th-century observatory with the world’s largest stone sundial."},{"t":"Albert Hall Museum","h":"अल्बर्ट हॉल म्यूज़ियम","u":"map.html#place-albert","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Indo-Saracenic museum in Ram Niwas Garden – stunning when lit up at night."},{"t":"Nahargarh Fort","h":"नाहरगढ़ किला","u":"map.html#place-nahargarh","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Ridge-top fort with the best sunset view over the Pink City."},{"t":"Jaigarh Fort","h":"जयगढ़ किला","u":"map.html#place-jaigarh","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Hilltop fort above Amer, home to the giant Jaivana cannon."},{"t":"Jal Mahal","h":"जल महल","u":"map.html#place-jalmahal","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Palace in Man Sagar Lake – admire it from the lakeside promenade."},{"t":"Patrika Gate","h":"पत्रिका गेट","u":"map.html#place-patrika","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Colourful painted gateway at Jawahar Circle – a photographer’s favourite."},{"t":"Birla Mandir","h":"बिड़ला मंदिर","u":"map.html#place-birla","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Serene white-marble Lakshmi Narayan temple below Moti Dungri."},{"t":"Galtaji Temple","h":"गलताजी मंदिर","u":"map.html#place-galta","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Ancient temple complex with natural springs, known as the Monkey Temple."},{"t":"Panna Meena ka Kund","h":"पन्ना मीणा का कुंड","u":"map.html#place-panna","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Symmetrical 16th-century stepwell near Amer."},{"t":"Sisodia Rani Garden","h":"सिसोदिया रानी बाग़","u":"map.html#place-sisodia","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Terraced 18th-century garden with fountains and murals."},{"t":"Raj Mandir Cinema","h":"राज मंदिर सिनेमा","u":"map.html#place-rajmandir","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🏰","d":"Iconic art-deco cinema hall – a Jaipur experience in itself."},{"t":"Laxmi Misthan Bhandar (LMB)","h":"लक्ष्मी मिष्ठान भंडार (LMB)","u":"map.html#place-lmb","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🍽️","d":"Legendary sweets and Rajasthani thali in Johari Bazaar."},{"t":"Rawat Mishthan Bhandar","h":"रावत मिष्ठान भंडार","u":"map.html#place-rawat","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🍽️","d":"Famous for pyaaz kachori and mawa kachori."},{"t":"Lassiwala, MI Road","h":"लस्सीवाला, एमआई रोड","u":"map.html#place-lassi","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🍽️","d":"Thick lassi in clay kulhads – a Jaipur institution."},{"t":"Masala Chowk","h":"मसाला चौक","u":"map.html#place-masala","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🍽️","d":"Open-air food court in Ram Niwas Garden with the city’s best street food."},{"t":"Pandit Kulfi","h":"पंडित कुल्फ़ी","u":"map.html#place-pandit","g":"Places","p":"Map & Near Me","ph":"नक्शा और आस-पास","e":"🍽️","d":"Much-love